# ============================================================
#  Copiază acest fișier în `.env.local` și completează valorile.
#  `.env.local` NU se comite (e în .gitignore).
# ============================================================

# ---- Firebase Web App (CLIENT) — expuse în browser, sunt publice by design ----
# Din consola Firebase: Project settings → General → Your apps → Web app (</>)
# → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=team-pulse-e5724.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=team-pulse-e5724
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=team-pulse-e5724.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Id-ul documentului Firestore care ține tot state-ul CRM (implicit „main”).
NEXT_PUBLIC_CRM_DOC_ID=main

# URL-ul public al aplicației (folosit ca destinație pentru magic link).
# În dev lasă gol — se folosește originul cererii. În producție pune domeniul real.
NEXT_PUBLIC_APP_URL=

# ---- Firebase Admin (SERVER) — SECRET, nu se expune niciodată în client ----
# Din service account (NU key-ul de Web App). Rotește cheia dacă a fost expusă.
FIREBASE_ADMIN_PROJECT_ID=team-pulse-e5724
FIREBASE_ADMIN_CLIENT_EMAIL=
# Cheia privată pe o singură linie, cu `\n` literal în loc de newline-uri.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- ZeptoMail (SERVER) — trimiterea magic link-ului ----
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=no-reply@emthrive.com
ZEPTOMAIL_FROM_NAME=Emthrive CRM
# Pentru conturi din regiunea EU: https://api.zeptomail.eu/v1.1/email
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# ---- Whitelist de acces ----
# Whitelist-ul e dat de emailurile membrilor adăugați din platformă (Echipă).
# BOOTSTRAP_ADMIN_EMAILS = adresele care pot intra din start (până există membri),
# ca să poată adăuga restul echipei. Separate prin virgulă.
# Cine cere link fără să fie pe whitelist NU primește email şi NU vede eroare.
BOOTSTRAP_ADMIN_EMAILS=contact@emthrive.com

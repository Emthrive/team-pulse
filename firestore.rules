rules_version = '2';

// Reguli Firestore pentru TeamPulse.
// - crm/{docId}: tot state-ul CRM (un singur document JSON).
// - users/{uid}: un document per cont autentificat (email, rol, login-uri).
// Accesul e permis DOAR utilizatorilor autentificați (magic link).
service cloud.firestore {
  match /databases/{database}/documents {
    match /crm/{docId} {
      allow read, write: if request.auth != null;
    }
    match /users/{uid} {
      // oricine autentificat poate citi lista; fiecare își scrie doar propriul document
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

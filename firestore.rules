rules_version = '2';

// Reguli Firestore pentru Emthrive CRM.
// Tot state-ul CRM stă într-un singur document: crm/{docId}.
// Accesul e permis DOAR utilizatorilor autentificați (magic link).
service cloud.firestore {
  match /databases/{database}/documents {
    match /crm/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
